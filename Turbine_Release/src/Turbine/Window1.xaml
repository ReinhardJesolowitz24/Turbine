<Window x:Class="Turbine.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Turbine V5.2" Height="750" Width="458" Foreground="Silver" Visibility="Collapsed" AllowsTransparency="False" FontSize="11" Loaded="Window_Loaded" WindowStyle="ThreeDBorderWindow" Topmost="False" WindowStartupLocation="CenterScreen" VerticalAlignment="Center" HorizontalAlignment="Center" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">


    <Grid Height="700" Width="440" Background="#F0F0F0">
        <Grid.Resources>
            <Style TargetType="Button" x:Key="MightyBaseStyle">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="DarkGray" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Image Name="image1" Stretch="Fill" StretchDirection="Both" Focusable="False" ClipToBounds="False" SnapsToDevicePixels="True" Source="T9x.jpg" ImageFailed="image1_ImageFailed_1" Margin="0,0,-3.333,0"></Image>
        <Image ClipToBounds="False" Focusable="False" Name="image6" SnapsToDevicePixels="True" Source="T9X2.jpg" Stretch="Fill" StretchDirection="Both" Visibility="Hidden" Margin="0,0,-4,0" />
        <TextBox Height="24" Margin="6,109,10,0" Name="textBox1" VerticalAlignment="Top" Visibility="Visible" TextChanged="textBox1_TextChanged" Background="Transparent" BorderBrush="LightBlue">
            
        </TextBox>
        <TextBox Margin="6,206,10,0" Name="textBox2" Height="24" VerticalAlignment="Top" Background="Transparent" BorderBrush="LightBlue" TextChanged="textBox2_TextChanged" Visibility="Visible" />
        <Label HorizontalAlignment="Left" Margin="4.89,0,0,155" Name="label3" Width="118" FontSize="13" Height="31.054" VerticalAlignment="Bottom">type in the key</Label>
        <Label Height="28" HorizontalAlignment="Left" Margin="6,0,0,104" Name="label4" VerticalAlignment="Bottom" Width="146" FontSize="13">confirm the key</Label>
        <Button Height="33" Margin="126,0,126,35" Name="button1" VerticalAlignment="Bottom" FontSize="14" Foreground="Black" Background="SpringGreen" Click="button1_Click" BorderBrush="DodgerBlue" FontFamily="Tahoma" Visibility="Visible" SnapsToDevicePixels="False" ClipToBounds="True" ToolTip="Start encryption/decryption">
            <Button.BitmapEffectInput>
                <BitmapEffectInput AreaToApplyEffectUnits="RelativeToBoundingBox" />
            </Button.BitmapEffectInput> START</Button>
        <Button Height="29" Margin="6,67,0,0" Name="button2" VerticalAlignment="Top" Click="button2_Click" ToolTip="choose Source file" Background="White" HorizontalAlignment="Left" Width="146" FontSize="12">Source file</Button>
        <Button Height="29" Margin="6,172,0,0" Name="button3" VerticalAlignment="Top" Click="button3_Click" Background="White" HorizontalAlignment="Left" Width="146" FontSize="12" ToolTip="choose Target file">Target file</Button>
        <Button Height="28.632" HorizontalAlignment="Right" Margin="0,16.159,10,0" Name="button4" VerticalAlignment="Top" Width="84" Click="button4_Click" Background="White" ToolTip="General Information and Terms of Use" FontSize="12">Terms of use</Button>
        <PasswordBox Margin="6,0,10,128" Name="textBox3" ToolTip="minimum 6 characters" PasswordChanged="textBox3_PasswordChanged" Height="34" VerticalAlignment="Bottom" MaxLength="1024" Opacity="1" SnapsToDevicePixels="False" ClipToBounds="False" Background="Transparent" BorderBrush="LightBlue" FontSize="18" />
        <PasswordBox Height="34" Margin="4.89,0,11.11,75" Name="textBox4" VerticalAlignment="Bottom" Password="" ToolTip="minimum 6 characters" PasswordChanged="textBox4_PasswordChanged" MaxLength="1025" Background="Transparent" BorderBrush="LightBlue" FontSize="18" />
        <!-- 2026-05-20: label5 wird durch zwei BMP-Logos ersetzt (image_logo_normal / image_logo_burning).
             label5 bleibt zur Sicherheit/Accessibility im Tree, aber unsichtbar (Visibility=Hidden).
             Falls die BMPs nicht laden, koennte man label5 wieder auf Visible setzen als Fallback. -->
        <Label Height="37.774" HorizontalAlignment="Left" Margin="18.681,8.861,0,0" Name="label5" VerticalAlignment="Top" Width="132.209" FontSize="20" Foreground="Black" Visibility="Hidden">
            <Label.BitmapEffect>
                <EmbossBitmapEffect />
            </Label.BitmapEffect> Turbine V5.2
        </Label>
        <!-- 2026-05-20: Top-Margin von 8.861 auf 15.861 erhoeht (+7 px),
             damit die Logo-Mitte tiefer sitzt (Feedback "Grafiken_zu_hoch.png"). -->
        <Image Name="image_logo_normal" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="18.681,15.861,0,0" Width="132.209" Height="37.774"
               Stretch="Uniform" SnapsToDevicePixels="True"
               Source="/Turbine;component/turbine_logo.bmp" Visibility="Visible" />
        <Image Name="image_logo_burning" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="18.681,15.861,0,0" Width="132.209" Height="37.774"
               Stretch="Uniform" SnapsToDevicePixels="True"
               Source="/Turbine;component/turbine_logo_burning.bmp" Visibility="Hidden" />
        <TextBox Height="34" Margin="6,0,10,128" Name="textBox5" VerticalAlignment="Bottom" TextChanged="textBox5_TextChanged" IsReadOnly="False" ToolTip="minimum 6 characters" Visibility="Hidden" BorderBrush="LightBlue" FontSize="18" Background="Transparent" />
        <RadioButton Height="25.553" HorizontalAlignment="Left" Margin="10,0,0,193" Name="radioButton1" VerticalAlignment="Bottom" Width="132.209" Checked="radioButton1_Checked_1" FontSize="13" GroupName="Group1" ToolTip="If the key is displayed, the key must not be repeated.">key is visible</RadioButton>
        <RadioButton Height="25.553" Margin="0,0,153,193" Name="radioButton2" VerticalAlignment="Bottom" Checked="radioButton2_Checked" IsChecked="True" FontSize="13" GroupName="Group1" ToolTip="If the key is hidden, it must be repeated." HorizontalAlignment="Right" Width="175.134">key is unvisible</RadioButton>
        <ProgressBar Height="18" Margin="6,0,10,10.908" Name="progressBar1" VerticalAlignment="Bottom" ValueChanged="progressBar1_ValueChanged" Background="Transparent" />
        <Button Margin="7,241,0,0" Name="button6" Click="button6_Click" HorizontalAlignment="Left" Width="144.89" ToolTip="use any file as a key" FontSize="12" Height="28.945" VerticalAlignment="Top">load key file  (optional)</Button>
        <ProgressBar Height="14" HorizontalAlignment="Right" Margin="0,0,11.11,169" Name="progressBar2" VerticalAlignment="Bottom" Width="162.206" ValueChanged="progressBar2_ValueChanged" Background="Transparent" />
        <Label HorizontalAlignment="Right" Margin="0,0,18.156,175" Name="label1" Width="128" FontSize="13" Height="33.33" VerticalAlignment="Bottom">key evaluation</Label>
        <Button Height="29" Margin="181.093,65,112.156,0" Name="button5" VerticalAlignment="Top" Click="button5_Click" Background="Yellow" ToolTip="delete Source files secure" FontSize="12">wipe Source file</Button>
        <Image Height="34.632" Margin="146,12.003,0,0" Name="image2" Stretch="Fill" VerticalAlignment="Top" Source="/Turbine;component/turbine.ico" Visibility="Hidden" ImageFailed="image2_ImageFailed" HorizontalAlignment="Left" Width="47.507" />
        <Image Height="34.632" Margin="146,12.003,0,0" Name="image3" Source="/Turbine;component/turbine2.ico" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="47.507" />
        <!-- 2026-05-20: image4 (Tur_effekt2.bmp brennende V4.1-Schrift) entfernt.
             Stattdessen wird der "brennende" Effekt allein durch
             label5.Foreground=Red + EmbossBitmapEffect erzeugt (im Code).
             Damit ist der Effekt versions-unabhaengig und zeigt immer den
             aktuellen Label-Text (V5.0 jetzt, V6.0 spaeter etc.). -->
        <Label HorizontalAlignment="Right" Margin="0,0,19,165" Name="label2" Width="130" FontSize="12" Visibility="Hidden" Foreground="Green" Height="25" VerticalAlignment="Bottom">key file is loaded</Label>
        <Image Margin="206,0,204,169" Name="image5" Stretch="Fill" Source="/Turbine;component/Schloss.JPG" Visibility="Hidden" Height="20" VerticalAlignment="Bottom" />
        <Button Margin="181.093,241,112.156,0" Name="button7" Click="button7_Click" Height="28.945" VerticalAlignment="Top">mighty mouse (optional)</Button>
        <!-- Mighty Mouse Keypad -->
        <Border Name="MightyMousePanel" Visibility="Hidden" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,275,0,0" Width="400" Background="#F5F5F5" BorderBrush="#555555" BorderThickness="2" CornerRadius="6" Padding="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Hex/Decimal Numbers 0-9 (existing handlers) -->
            <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
                <Button Name="button22" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button22_Click">0</Button>
                <Button Name="button23" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button23_Click">1</Button>
                <Button Name="button24" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button24_Click">2</Button>
                <Button Name="button8" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button8_Click">3</Button>
                <Button Name="button9" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button9_Click">4</Button>
                <Button Name="button10" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button10_Click">5</Button>
                <Button Name="button12" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button12_Click">6</Button>
                <Button Name="button11" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button11_Click">7</Button>
                <Button Name="button13" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button13_Click">8</Button>
                <Button Name="button14" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button14_Click">9</Button>
            </WrapPanel>

            <!-- Row 1: Common Special Characters (existing) -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="!"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="@"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="#"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="$"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="%"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="&amp;"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="*"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="-"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="_"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="+"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="="/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="."/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content=","/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="?"/>
            </WrapPanel>

            <!-- Row 2: Lowercase a-m (NEW - extends to full ASCII) -->
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="a"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="b"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="c"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="d"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="e"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="f"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="g"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="h"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="i"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="j"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="k"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="l"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="m"/>
            </WrapPanel>

            <!-- Row 3: Lowercase n-z (NEW) -->
            <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="n"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="o"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="p"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="q"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="r"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="s"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="t"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="u"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="v"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="w"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="x"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="y"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFFFCC" Click="SpecialChar_Click" Content="z"/>
            </WrapPanel>

            <!-- Row 4: Uppercase A-M (NEW - A-F integrated here, no longer separate hex row) -->
            <WrapPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="A"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="B"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="C"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="D"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="E"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="F"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="G"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="H"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="I"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="J"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="K"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="L"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="M"/>
            </WrapPanel>

            <!-- Row 5: Uppercase N-Z + SPACE (NEW) -->
            <WrapPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="N"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="O"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="P"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="Q"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="R"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="S"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="T"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="U"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="V"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="W"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="X"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="Y"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="SpecialChar_Click" Content="Z"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#D3D3D3" Click="SpecialChar_Click" Tag=" " Content="SP" FontSize="8" ToolTip="Space" Width="40"/>
            </WrapPanel>

            <!-- Row 6: Additional Symbols all in one row (NEW) -->
            <WrapPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,3,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="&quot;"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="'"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="("/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content=")"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="/"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content=":"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content=";"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="&lt;"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="&gt;"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="["/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="\"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="]"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="^"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="`"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="{}{"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="|"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="{}}"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="~"/>
            </WrapPanel>
        </Grid>
        </Border>
        <Label Height="28" HorizontalAlignment="Left" Margin="10,138,0,0" Name="label6" VerticalAlignment="Top" Width="120" FontWeight="Black" IsEnabled="False">Choose Source file</Label>
    </Grid>
</Window>
