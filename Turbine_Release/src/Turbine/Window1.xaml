<Window x:Class="Turbine.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Encryption Turbine" Height="750" Width="458" Foreground="Silver" Visibility="Collapsed" AllowsTransparency="False" FontSize="11" Loaded="Window_Loaded" WindowStyle="ThreeDBorderWindow" Topmost="False" WindowStartupLocation="CenterScreen" VerticalAlignment="Center" HorizontalAlignment="Center" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">


    <Grid Height="700" Width="440" Background="#F0F0F0">
        <Grid.Resources>
            <Style TargetType="Button" x:Key="MightyBaseStyle">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="DarkGray" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Image Name="image1" Stretch="Fill" StretchDirection="Both" Focusable="False" ClipToBounds="False" SnapsToDevicePixels="True" Source="T9x.jpg" ImageFailed="image1_ImageFailed_1" Margin="0,0,-3.333,0"></Image>
        <Image ClipToBounds="False" Focusable="False" Name="image6" SnapsToDevicePixels="True" Source="T9X2.jpg" Stretch="Fill" StretchDirection="Both" Visibility="Hidden" Margin="0,0,-4,0" />
        <TextBox Height="24" Margin="6,109,10,0" Name="textBox1" VerticalAlignment="Top" Visibility="Visible" TextChanged="textBox1_TextChanged" Background="Transparent" BorderBrush="LightBlue">
            
        </TextBox>
        <TextBox Margin="6,206,10,0" Name="textBox2" Height="24" VerticalAlignment="Top" Background="Transparent" BorderBrush="LightBlue" TextChanged="textBox2_TextChanged" Visibility="Visible" />
        <Label HorizontalAlignment="Left" Margin="4.89,0,0,155" Name="label3" Width="118" FontSize="13" Height="31.054" VerticalAlignment="Bottom">type in the key</Label>
        <Label Height="28" HorizontalAlignment="Left" Margin="6,0,0,104" Name="label4" VerticalAlignment="Bottom" Width="146" FontSize="13">confirm the key</Label>
        <Button Height="33" Margin="126,0,126,35" Name="button1" VerticalAlignment="Bottom" FontSize="14" Foreground="Black" Background="SpringGreen" Click="button1_Click" BorderBrush="DodgerBlue" FontFamily="Tahoma" Visibility="Visible" SnapsToDevicePixels="False" ClipToBounds="True" ToolTip="Start encryption/decryption">
            <Button.BitmapEffectInput>
                <BitmapEffectInput AreaToApplyEffectUnits="RelativeToBoundingBox" />
            </Button.BitmapEffectInput> START</Button>
        <Button Height="29" Margin="6,67,0,0" Name="button2" VerticalAlignment="Top" Click="button2_Click" ToolTip="choose Source file" Background="White" HorizontalAlignment="Left" Width="146" FontSize="12">Source file</Button>
        <Button Height="29" Margin="6,172,0,0" Name="button3" VerticalAlignment="Top" Click="button3_Click" Background="White" HorizontalAlignment="Left" Width="146" FontSize="12" ToolTip="choose Target file">Target file</Button>
        <Button Height="28.632" HorizontalAlignment="Right" Margin="0,16.159,10,0" Name="button4" VerticalAlignment="Top" Width="84" Click="button4_Click" Background="White" ToolTip="General Information and Terms of Use" FontSize="12">Terms of use</Button>
        <PasswordBox Margin="6,0,10,128" Name="textBox3" ToolTip="minimum 6 characters" PasswordChanged="textBox3_PasswordChanged" Height="34" VerticalAlignment="Bottom" MaxLength="1024" Opacity="1" SnapsToDevicePixels="False" ClipToBounds="False" Background="Transparent" BorderBrush="LightBlue" FontSize="18" />
        <PasswordBox Height="34" Margin="4.89,0,11.11,75" Name="textBox4" VerticalAlignment="Bottom" Password="" ToolTip="minimum 6 characters" PasswordChanged="textBox4_PasswordChanged" MaxLength="1025" Background="Transparent" BorderBrush="LightBlue" FontSize="18" />
        <Label Height="37.774" HorizontalAlignment="Left" Margin="18.681,8.861,0,0" Name="label5" VerticalAlignment="Top" Width="132.209" FontSize="20" Foreground="Black">
            <Label.BitmapEffect>
                <EmbossBitmapEffect />
            </Label.BitmapEffect> Turbine V4.1
        </Label>
        <TextBox Height="34" Margin="6,0,10,128" Name="textBox5" VerticalAlignment="Bottom" TextChanged="textBox5_TextChanged" IsReadOnly="False" ToolTip="minimum 6 characters" Visibility="Hidden" BorderBrush="LightBlue" FontSize="18" Background="Transparent" />
        <RadioButton Height="25.553" HorizontalAlignment="Left" Margin="10,0,0,193" Name="radioButton1" VerticalAlignment="Bottom" Width="132.209" Checked="radioButton1_Checked_1" FontSize="13" GroupName="Group1" ToolTip="If the key is displayed, the key must not be repeated.">key is visible</RadioButton>
        <RadioButton Height="25.553" Margin="0,0,153,193" Name="radioButton2" VerticalAlignment="Bottom" Checked="radioButton2_Checked" IsChecked="True" FontSize="13" GroupName="Group1" ToolTip="If the key is hidden, it must be repeated." HorizontalAlignment="Right" Width="175.134">key is unvisible</RadioButton>
        <ProgressBar Height="18" Margin="6,0,10,10.908" Name="progressBar1" VerticalAlignment="Bottom" ValueChanged="progressBar1_ValueChanged" Background="Transparent" />
        <Button Margin="7,241,0,0" Name="button6" Click="button6_Click" HorizontalAlignment="Left" Width="144.89" ToolTip="use any file as a key" FontSize="12" Height="28.945" VerticalAlignment="Top">load key file  (optional)</Button>
        <ProgressBar Height="14" HorizontalAlignment="Right" Margin="0,0,11.11,169" Name="progressBar2" VerticalAlignment="Bottom" Width="162.206" ValueChanged="progressBar2_ValueChanged" Background="Transparent" />
        <Label HorizontalAlignment="Right" Margin="0,0,18.156,175" Name="label1" Width="128" FontSize="13" Height="33.33" VerticalAlignment="Bottom">key evaluation</Label>
        <Button Height="29" Margin="181.093,65,112.156,0" Name="button5" VerticalAlignment="Top" Click="button5_Click" Background="Yellow" ToolTip="delete Source files secure" FontSize="12">wipe Source file</Button>
        <Image Height="34.632" Margin="146,12.003,0,0" Name="image2" Stretch="Fill" VerticalAlignment="Top" Source="/Turbine;component/turbine.ico" Visibility="Hidden" ImageFailed="image2_ImageFailed" HorizontalAlignment="Left" Width="47.507" />
        <Image Height="34.632" Margin="146,12.003,0,0" Name="image3" Source="/Turbine;component/turbine2.ico" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="47.507" />
        <Image Margin="18.681,12.003,0,0" Name="image4" Stretch="Fill" Height="29" VerticalAlignment="Top" Source="/Turbine;component/Tur_effekt2.bmp" Visibility="Hidden" HorizontalAlignment="Left" Width="125" />
        <Label HorizontalAlignment="Right" Margin="0,0,19,165" Name="label2" Width="130" FontSize="12" Visibility="Hidden" Foreground="Green" Height="25" VerticalAlignment="Bottom">key file is loaded</Label>
        <Image Margin="206,0,204,169" Name="image5" Stretch="Fill" Source="/Turbine;component/Schloss.JPG" Visibility="Hidden" Height="20" VerticalAlignment="Bottom" />
        <Button Margin="181.093,241,112.156,0" Name="button7" Click="button7_Click" Height="28.945" VerticalAlignment="Top">mighty mouse (optional)</Button>
        <!-- Mighty Mouse Keypad -->
        <Grid Name="MightyMousePanel" Visibility="Hidden" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,280" Width="400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Hex Numbers -->
            <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
                <Button Name="button22" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button22_Click">0</Button>
                <Button Name="button23" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button23_Click">1</Button>
                <Button Name="button24" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button24_Click">2</Button>
                <Button Name="button8" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button8_Click">3</Button>
                <Button Name="button9" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button9_Click">4</Button>
                <Button Name="button10" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button10_Click">5</Button>
                <Button Name="button12" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button12_Click">6</Button>
                <Button Name="button11" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button11_Click">7</Button>
                <Button Name="button13" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button13_Click">8</Button>
                <Button Name="button14" Style="{StaticResource MightyBaseStyle}" Background="LightBlue" Click="button14_Click">9</Button>
            </WrapPanel>
            
            <!-- Hex Letters -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Name="button15" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button15_Click">A</Button>
                <Button Name="button16" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button16_Click">B</Button>
                <Button Name="button17" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button17_Click">C</Button>
                <Button Name="button18" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button18_Click">D</Button>
                <Button Name="button19" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button19_Click">E</Button>
                <Button Name="button20" Style="{StaticResource MightyBaseStyle}" Background="LightGreen" Click="button20_Click">F</Button>
            </WrapPanel>

            <!-- Special Characters -->
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5,0,0">
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="!"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="@"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="#"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="$"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="%"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="&amp;"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="*"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="-"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="_"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="+"/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="="/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="."/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content=","/>
                 <Button Style="{StaticResource MightyBaseStyle}" Background="#FFD700" Click="SpecialChar_Click" Content="?"/>
            </WrapPanel>
        </Grid>
        <Label Height="28" HorizontalAlignment="Left" Margin="10,138,0,0" Name="label6" VerticalAlignment="Top" Width="120" FontWeight="Black" IsEnabled="False">Choose Source file</Label>
    </Grid>
</Window>
